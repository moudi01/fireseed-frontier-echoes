config_version=5

[application]
config/name="AI觉醒Boss · 开发切片"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]
DisplayPreferences="*res://core/display_preferences.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.045, 0.065, 1)

[filesystem]
import/blender/enabled=false

[debug]
gdscript/warnings/untyped_declaration=0
